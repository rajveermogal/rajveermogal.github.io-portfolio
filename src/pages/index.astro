        font-weight: 900;
        font-size: 13px;
        color: var(--accent);
        letter-spacing: 1px;
      }
      .proj-tag {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.5px;
        color: var(--muted);
      }

      .proj-name {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: clamp(22px, 3vw, 32px);
        letter-spacing: -0.5px;
        margin-bottom: 16px;
        line-height: 1.1;
      }
      .proj-desc {
        font-size: 15px;
        font-weight: 400;
        color: rgba(240,240,240,0.72);
        line-height: 1.65;
        max-width: 640px;
        margin-bottom: 20px;
      }
      .proj-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 20px;
      }
      .proj-chips span {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        padding: 5px 12px;
        border: 1px solid var(--border);
        color: var(--muted);
      }
      .proj-link {
        display: inline-block;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: var(--accent);
        border-bottom: 1px solid rgba(255,128,0,0.35);
        padding-bottom: 2px;
        transition: border-color 150ms;
      }
      .proj-link:hover { border-color: var(--accent); }

      /* ══════════════════════════════════════
         EXPERIENCE
      ══════════════════════════════════════ */
      .exp-list { display: flex; flex-direction: column; }

      .exp-item {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 40px;
        padding: 32px 0;
        border-top: 1px solid var(--border);
        transition: background 200ms ease;
      }
      .exp-item:last-child { border-bottom: 1px solid var(--border); }
      .exp-item:hover { background: rgba(255,255,255,0.015); }

      .exp-left { padding-top: 3px; }
      .exp-time {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.5px;
        color: var(--muted);
      }

      .exp-role {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 16px;
        line-height: 1.3;
        margin-bottom: 6px;
      }
      .exp-org {
        font-size: 13px;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 10px;
        letter-spacing: 0.3px;
      }
      .exp-note {
        font-size: 14px;
        color: rgba(240,240,240,0.60);
        line-height: 1.55;
        max-width: 560px;
      }

      /* ══════════════════════════════════════
         ABOUT
      ══════════════════════════════════════ */
      .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: start;
      }
      .about-text p {
        font-size: 16px;
        line-height: 1.75;
        color: rgba(240,240,240,0.75);
        margin-bottom: 48px;
      }
      .about-stats {
        display: flex;
        gap: 48px;
        border-top: 1px solid var(--border);
        padding-top: 32px;
      }
      .stat { display: flex; flex-direction: column; gap: 4px; }
      .stat-num {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 40px;
        line-height: 1;
        color: var(--accent);
        letter-spacing: -1px;
      }
      .stat-label {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--muted);
      }

      .about-pillars { display: flex; flex-direction: column; gap: 0; }
      .pillar {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 24px 0;
        border-top: 1px solid var(--border);
      }
      .pillar:last-child { border-bottom: 1px solid var(--border); }
      .pillar-label {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 0.2px;
      }
      .pillar-text {
        font-size: 14px;
        color: rgba(240,240,240,0.60);
        line-height: 1.55;
      }

      /* ══════════════════════════════════════
         CONTACT
      ══════════════════════════════════════ */
      .section--contact {
        padding-top: 140px;
        padding-bottom: 140px;
      }
      .contact-inner { display: flex; flex-direction: column; gap: 20px; }
      .contact-heading {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: clamp(48px, 8vw, 100px);
        letter-spacing: -2px;
        line-height: 0.95;
        margin-top: 8px;
      }
      .contact-email {
        display: inline-block;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(20px, 3vw, 32px);
        color: var(--accent);
        border-bottom: 2px solid rgba(255,128,0,0.3);
        padding-bottom: 3px;
        margin-top: 16px;
        transition: border-color 150ms;
        align-self: flex-start;
      }
      .contact-email:hover { border-color: var(--accent); }
      .contact-links {
        display: flex;
        gap: 24px;
        margin-top: 8px;
      }
      .contact-links a {
        font-size: 13px;
        font-weight: 500;
        color: var(--muted);
        letter-spacing: 0.5px;
        transition: color 150ms;
      }
      .contact-links a:hover { color: var(--text); }

      /* ══════════════════════════════════════
         FOOTER
      ══════════════════════════════════════ */
      .footer {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 40px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        font-weight: 500;
        color: var(--muted);
        letter-spacing: 0.5px;
      }
      .footer-top { transition: color 150ms; }
      .footer-top:hover { color: var(--text); }

      /* ══════════════════════════════════════
         RESPONSIVE
      ══════════════════════════════════════ */
      @media (max-width: 768px) {
        .nav { padding: 0 20px; }
        .nav-links { display: none; }

        .hero-step { padding: 0 20px 60px; }
        .hero-hint { right: 20px; }
        .hero-name { letter-spacing: -2px; }

        .hero-card { flex-direction: column; gap: 24px; padding: 24px 20px; }
        .hero-card-links { align-items: flex-start; }

        .section { padding: 80px 20px; }
        .section-header { flex-direction: column; gap: 8px; margin-bottom: 40px; }

        .proj-item { grid-template-columns: 1fr; gap: 16px; }
        .proj-meta { flex-direction: row; align-items: center; gap: 16px; }

        .exp-item { grid-template-columns: 1fr; gap: 12px; }

        .about-grid { grid-template-columns: 1fr; gap: 48px; }
        .about-stats { gap: 32px; }

        .footer { padding: 20px; }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-name-line, .hero-eyebrow { animation: none; opacity: 1; transform: none; }
        .hero-hint { animation: none; }
        .reveal { transition: opacity 200ms ease; }
      }
    </style>

  </body>

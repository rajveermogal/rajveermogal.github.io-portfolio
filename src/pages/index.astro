    <script>
      /* ── helpers ───────────────────────── */
      function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }

      /* ── hero scroll reveal ────────────── */
      const heroStage = document.getElementById("heroStage");
      const step2     = document.querySelector('[data-step="2"]');
      const step3     = document.querySelector('[data-step="3"]');
      const heroHint  = document.getElementById("heroHint");

      function onHeroScroll() {
        if (!heroStage || !step2 || !step3) return;
        const r      = heroStage.getBoundingClientRect();
        const total  = heroStage.offsetHeight - window.innerHeight;
        const p      = total > 0 ? clamp(-r.top, 0, total) / total : 0;

        const s2 = clamp((p - 0.20) / 0.22, 0, 1);
        step2.style.opacity   = s2;
        step2.style.transform = `translateY(${(1 - s2) * 28}px)`;
        step2.style.filter    = `blur(${(1 - s2) * 5}px)`;

        const s3 = clamp((p - 0.54) / 0.22, 0, 1);
        step3.style.opacity   = s3;
        step3.style.transform = `translateY(${(1 - s3) * 28}px)`;
        step3.style.filter    = `blur(${(1 - s3) * 5}px)`;

        if (heroHint) {
          heroHint.style.opacity   = `${clamp(1 - s2 * 2, 0, 1)}`;
          heroHint.style.transform = `translateY(${s2 * 12}px)`;
        }
      }
      window.addEventListener("scroll", onHeroScroll, { passive: true });
      window.addEventListener("resize", onHeroScroll);
      onHeroScroll();

      /* ── scroll reveal ─────────────────── */
      const revealIO = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add("in"); }),
        { threshold: 0.12 }
      );
      document.querySelectorAll("[data-reveal]").forEach(el => revealIO.observe(el));

      /* ── tilt ──────────────────────────── */
      document.querySelectorAll("[data-tilt]").forEach(el => {
        let raf = null;
        el.addEventListener("mousemove", e => {
          const r  = el.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top)  / r.height;
          if (raf) cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            el.style.transform = `perspective(1000px) rotateX(${(0.5 - py) * 10}deg) rotateY(${(px - 0.5) * 14}deg) translateZ(8px)`;
          });
        });
        el.addEventListener("mouseleave", () => {
          if (raf) cancelAnimationFrame(raf);
          el.style.transform = "";
        });
      });

      /* ── hero name stagger ─────────────── */
      window.addEventListener("load", () => {
        document.querySelectorAll("[data-line]").forEach((el, i) => {
          el.style.animationDelay = `${i * 0.12}s`;
          el.classList.add("name-in");
        });
      });
    </script>

    <style>
      /* ══════════════════════════════════════
         TOKENS
      ══════════════════════════════════════ */
      :root {

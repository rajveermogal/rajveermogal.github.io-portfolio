        --fontDisplay: "Sora", "Space Grotesk", ui-sans-serif, system-ui;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        color: var(--text);
        font-family: var(--fontBody);
        background:
          radial-gradient(1000px 650px at 18% 14%, rgba(255, 128, 0, 0.09), transparent 60%),
          radial-gradient(1000px 700px at 82% 24%, rgba(0, 167, 255, 0.09), transparent 60%),
          linear-gradient(180deg, var(--bg0), var(--bg1));
        overflow-x: hidden;

        font-weight: 700;
        font-size: clamp(20px, 3vw, 36px);
        line-height: 1.3;
        font-style: italic;
        color: rgba(255,255,255,0.75);
        max-width: 820px;
        border-left: 3px solid var(--accent);
        padding-left: 28px;
        transform-style: preserve-3d;

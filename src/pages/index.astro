      /* ══════════════════════════════════════
         HERO
      ══════════════════════════════════════ */
      .hero-stage {
        position: relative;
        height: 200vh;
      }
      .hero-sticky {
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      .hero-step {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-end;
        padding: 0 40px 72px;
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
        left: 50%;
        transform: translateX(-50%);
      }

      /* Step 1 */
      .step-1 { z-index: 1; }

      .hero-eyebrow {
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 20px;
        opacity: 0;
        animation: fadeUp 0.6s 0.5s ease forwards;
      }

      .hero-name {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: clamp(80px, 14vw, 180px);
        line-height: 0.88;
        letter-spacing: -3px;
        text-transform: uppercase;
        color: var(--text);
      }
      .hero-name-line {
        display: block;
        opacity: 0;
        transform: translateY(40px);
        transition: none;
      }
      .hero-name-line.name-in {
        animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
      @keyframes slideUp {
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
      }

      .hero-hint {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        color: var(--muted);
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
        position: absolute;
        bottom: 32px;
        right: 40px;
        transition: opacity 200ms ease, transform 200ms ease;
        animation: bob 2s ease-in-out infinite;
      }
      .hero-hint span:first-child { font-size: 18px; }
      @keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(6px); } }

      /* Step 2 — role card */
      .step-2, .step-3 {
        opacity: 0;
        will-change: transform, opacity, filter;
      }

      .hero-card {
        width: 100%;
        max-width: 720px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 40px;
        padding: 36px 40px;
        border: 1px solid var(--border);
        border-left: 3px solid var(--accent);
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(16px);
        transform-style: preserve-3d;
        transition: transform 120ms ease;
      }
      .hero-card-label {
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 12px;
      }
      .hero-card-title {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: clamp(18px, 2.4vw, 26px);
        line-height: 1.1;
        letter-spacing: 0.5px;
        color: var(--text);
        margin-bottom: 10px;
      }
      .hero-card-roles {
        font-size: 13px;
        font-weight: 500;
        color: var(--accent);
        letter-spacing: 1px;
      }
      .hero-card-links {

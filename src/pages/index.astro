      }
      .heroStep {
        width: min(1040px, 94vw);
        display: grid;
        place-items: center;
        gap: 16px;
        height: 100%;
        align-content: center;
        transform: translateY(8vh);
      }
      .heroStep2, .heroStep3 {
        opacity: 0;
        transform: translateY(22px) scale(0.98);
        filter: blur(6px);
        will-change: transform, opacity, filter;
      }

      .heroName {
        margin: 0;
        font-family: var(--fontDisplay);
        font-weight: 950;
        letter-spacing: 2.4px;
        text-transform: uppercase;
        line-height: 0.92;
        font-size: clamp(70px, 11vw, 138px);
        text-align: center;
      }

      .nameFrame {
        position: relative;
        display: inline-block;
        padding: 14px;
        border-radius: 30px;
        isolation: isolate;
      }
      .nameFrame::before {
        content: "";
        position: absolute;
        inset: -8px;
        border-radius: 36px;
        background: conic-gradient(
          from 210deg,
          rgba(255, 128, 0,  0.95),
          rgba(0,   167, 255, 0.90),
          rgba(255, 154, 53, 0.88),
          rgba(255, 128, 0,  0.95)
        );
        filter: blur(12px);
        opacity: 0.38;
        z-index: -1;
        animation: ringPulse 4s ease-in-out infinite;
        transition: opacity 1200ms ease, filter 1200ms ease;
      }
      .nameFrame::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 30px;
        background: rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.14);
        z-index: -1;
        box-shadow: 0 26px 90px rgba(0, 0, 0, 0.60);
      }
      @keyframes ringPulse {
        0%,100%{ transform: scale(1);     opacity: 0.32; }
        50%    { transform: scale(1.035); opacity: 0.54; }
      }
      .nameGlow {
        display: inline-block;
        padding: 14px 26px;
        border-radius: 24px;
        background: rgba(0, 0, 0, 0.18);
        text-shadow: 0 10px 45px rgba(255, 128, 0, 0.16);
      }

      .heroHint {
        display: grid;
        place-items: center;
        gap: 2px;
        color: rgba(238, 244, 255, 0.74);
        font-weight: 900;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        transition: opacity 220ms ease, transform 220ms ease;
        user-select: none;
      }
      .hintArrow { font-size: 20px; animation: bob 1.1s ease-in-out infinite; }
      .hintText  { font-size: 12px; opacity: 0.9; }
      @keyframes bob { 0%,100%{transform:translateY(0)} 50%{transform:translateY(8px)} }

      /* Hero card */
      .heroCard {
        width: 100%;
        border-radius: 28px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background:
          radial-gradient(900px 420px at 50% 0%, rgba(255, 128, 0, 0.10), transparent 70%),
          linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.03));
        box-shadow: var(--shadow);
        padding: 26px 20px 22px;
        text-align: center;
        backdrop-filter: blur(16px);
      }
      .heroKicker {
        font-family: var(--fontDisplay);
        font-weight: 950;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: rgba(238, 244, 255, 0.92);
        font-size: clamp(14px, 1.9vw, 16px);
      }
      .heroRoles {
        margin-top: 10px;
        font-weight: 900;
        letter-spacing: 0.9px;
        text-transform: uppercase;
        color: var(--papaya);
        font-size: clamp(12px, 1.6vw, 14px);
      }
      .heroActions { display: flex; justify-content: center; gap: 12px; margin-top: 18px; }

      /* Quote pill */
      .quotePill {
        width: min(980px, 92vw);
        text-align: center;
        padding: 14px 18px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(0, 0, 0, 0.20);
        color: rgba(238, 244, 255, 0.92);
        font-weight: 900;
        box-shadow: 0 16px 44px rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(12px);
      }

      /* ── Sections ── */
      .section { padding: 72px 18px; max-width: 1080px; margin: 0 auto; position: relative; z-index: 10; }
      .sectionHead { margin-bottom: 18px; }
      .sectionHead.center { text-align: center; }
      .sectionTitle {
        margin: 0;
        font-family: var(--fontDisplay);
        font-weight: 950;
        letter-spacing: 0.6px;
        font-size: 30px;
      }

      .reveal {
        opacity: 0;
        transform: translateY(22px) scale(0.985);
        filter: blur(6px);
        transition: opacity 420ms ease, transform 420ms cubic-bezier(.2,.8,.2,1), filter 420ms ease;
        will-change: transform, opacity, filter;
      }
      .reveal.in { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }

      .tilt { transform-style: preserve-3d; transition: transform 120ms ease, box-shadow 120ms ease; }

      /* ── Projects ── */
      .projectsSection { position: relative; z-index: 20; isolation: isolate; scroll-margin-top: 92px; }
      .projectsBay {
        border-radius: 26px;
        border: 1px solid rgba(255, 255, 255, 0.10);
        background:
          radial-gradient(1100px 340px at 18% 0%, rgba(255, 128, 0, 0.08), transparent 62%),
          radial-gradient(1100px 340px at 82% 0%, rgba(0, 167, 255, 0.07), transparent 62%),
          rgba(0, 0, 0, 0.20);
        box-shadow: 0 32px 120px rgba(0, 0, 0, 0.64);
        padding: 22px;
        overflow: hidden;
      }
      .projectsHeader {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 16px;
        align-items: start;
        padding: 10px 10px 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        margin-bottom: 18px;
      }
      .projectsTitle {
        margin: 0;
        font-family: var(--fontDisplay);
        font-weight: 950;
        letter-spacing: 0.6px;
        font-size: 38px;
      }
      .projectsSub { margin: 10px 0 0; color: var(--muted); font-weight: 750; line-height: 1.45; max-width: 62ch; }
      .projectsHeaderRight { text-align: right; display: grid; gap: 8px; align-content: start; }
      .projectsKicker {
        font-family: var(--fontDisplay);
        font-weight: 950;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: rgba(238, 244, 255, 0.92);
        font-size: 14px;
      }
      .projectsRoles {
        font-weight: 900;
        letter-spacing: 0.9px;
        text-transform: uppercase;
        color: var(--papaya);
        font-size: 12px;
      }
      .projectsIcons { display: flex; justify-content: flex-end; gap: 10px; margin-top: 2px; }

      .projGrid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }
      .projCard {
        border-radius: 22px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background:
          radial-gradient(900px 280px at 18% 0%, rgba(255, 128, 0, 0.07), transparent 60%),
          radial-gradient(900px 280px at 82% 0%, rgba(0, 167, 255, 0.06), transparent 60%),
          rgba(0, 0, 0, 0.20);
        padding: 18px;
        box-shadow: 0 16px 44px rgba(0, 0, 0, 0.45);
        transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease, filter 140ms ease;
      }
      .projCard:hover {
        transform: translateY(-2px) scale(1.02);
        border-color: rgba(255, 128, 0, 0.32);
        box-shadow: 0 26px 80px rgba(0, 0, 0, 0.65);
        filter: saturate(1.06);
      }
      .projTop { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
      .projTop h3 { margin: 0; font-weight: 950; letter-spacing: 0.2px; }
      .projTag {
        font-size: 12px;
        font-weight: 900;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(238, 244, 255, 0.78);
        white-space: nowrap;
      }
      .projCard p { margin: 12px 0 0; color: rgba(238, 244, 255, 0.74); line-height: 1.45; font-weight: 700; }
      .projMeta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
      .chip {
        font-size: 12px;
        font-weight: 900;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(255, 128, 0, 0.20);
        background: rgba(255, 128, 0, 0.06);
        color: rgba(238, 244, 255, 0.80);
      }
      .projBtns { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }

      /* ── Experience ── */
      .vTimeline { position: relative; margin-top: 18px; padding: 10px 0 0; display: grid; gap: 18px; }
      .vLine {
        position: absolute;
        left: 22px; top: 0; bottom: 0;
        width: 2px;
        background: linear-gradient(180deg, rgba(255,128,0,0.0), rgba(255,128,0,0.40), rgba(0,167,255,0.22), rgba(255,128,0,0.0));
        opacity: 0.9;
      }
      .vItem {
        position: relative;
        padding-left: 54px;
        transition: transform 150ms ease, filter 150ms ease;
        will-change: transform;
      }
      .vDot {
        position: absolute;
        left: 18px; top: 26px;
        width: 12px; height: 12px;
        border-radius: 999px;
        background: var(--papaya);
        box-shadow: 0 0 0 8px rgba(255,128,0,0.10), 0 0 28px rgba(255,128,0,0.28);
      }
      .vCard {
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background:
          radial-gradient(900px 260px at 12% 0%, rgba(255, 128, 0, 0.08), transparent 60%),
          rgba(0, 0, 0, 0.20);
        padding: 16px 16px 14px;
        box-shadow: 0 16px 44px rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(12px);
        transition: border-color 120ms ease, box-shadow 120ms ease, transform 150ms ease;
      }
      .vTop { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
      .vRole { font-weight: 950; }
      .vTime { color: rgba(238, 244, 255, 0.66); font-weight: 900; font-size: 13px; white-space: nowrap; }
      .vOrg  { color: var(--papaya); margin-top: 6px; font-weight: 900; }
      .vNote { color: rgba(238, 244, 255, 0.70); margin-top: 8px; line-height: 1.4; font-weight: 700; }

      .vItem:hover .vCard { border-color: rgba(255, 128, 0, 0.30); box-shadow: 0 24px 70px rgba(0, 0, 0, 0.65); }
      .vItem.hot { transform: translateY(-8px) scale(1.06); filter: saturate(1.10); }
      .vItem.hot .vCard { border-color: rgba(255, 128, 0, 0.40); box-shadow: 0 28px 86px rgba(0, 0, 0, 0.72); }

      /* ── About ── */
      .aboutGrid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 14px; margin-top: 18px; }
      .card {
        border-radius: 18px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(0, 0, 0, 0.20);
        padding: 18px;
        box-shadow: 0 16px 44px rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(12px);
      }
      .aboutMain { padding: 22px; }
      .aboutText { margin: 0; color: rgba(238, 244, 255, 0.80); font-weight: 750; line-height: 1.55; font-size: 16px; }
      .aboutStats { margin-top: 18px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
      .stat {
        border-radius: 16px;
        border: 1px solid rgba(255, 128, 0, 0.16);
        background: rgba(255, 128, 0, 0.05);
        padding: 14px;
        text-align: center;
      }
      .statNum { font-family: var(--fontDisplay); font-weight: 950; font-size: 22px; color: var(--papaya); }
      .statLbl { margin-top: 6px; color: rgba(238, 244, 255, 0.70); font-weight: 900; font-size: 12px; text-transform: uppercase; letter-spacing: 0.8px; }
      .aboutSide { display: grid; gap: 14px; }
      .mini { padding: 16px; }
      .miniTitle { font-weight: 950; letter-spacing: 0.2px; }
      .miniText  { margin-top: 8px; color: rgba(238, 244, 255, 0.72); font-weight: 750; line-height: 1.45; }

      /* ── Contact ── */
      .contactCenter { margin-top: 18px; display: grid; justify-items: center; gap: 14px; }
      .ctaMain {
        width: min(760px, 92vw);
        display: grid;
        grid-template-columns: 56px 1fr 44px;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 22px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background:
          radial-gradient(900px 250px at 20% 0%, rgba(255, 128, 0, 0.14), transparent 60%),
          radial-gradient(900px 250px at 80% 0%, rgba(0, 167, 255, 0.10), transparent 60%),
          rgba(0, 0, 0, 0.20);
        text-decoration: none;
        color: var(--text);
        box-shadow: 0 26px 90px rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(14px);
        transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease, filter 140ms ease;
      }
      .ctaMain:hover { transform: translateY(-2px) scale(1.02); border-color: rgba(255, 128, 0, 0.45); box-shadow: 0 34px 110px rgba(0, 0, 0, 0.70); filter: saturate(1.06); }
      .ctaIcon {
        width: 56px; height: 56px;
        display: grid; place-items: center;
        border-radius: 16px;
        background: var(--papaya);
        color: #0b0f12;
        font-weight: 950;
        box-shadow: 0 18px 52px rgba(255, 128, 0, 0.22);
      }
      .ctaText   { display: grid; gap: 2px; }
      .ctaTop    { font-family: var(--fontDisplay); font-weight: 950; letter-spacing: 0.4px; }
      .ctaBottom { color: rgba(238, 244, 255, 0.72); font-weight: 800; }
      .ctaArrow {
        justify-self: end;
        width: 44px; height: 44px;
        display: grid; place-items: center;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(238, 244, 255, 0.92);
        font-weight: 950;
      }
      .contactPills { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
      .pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.06);
        text-decoration: none;
        color: rgba(238, 244, 255, 0.92);
        font-weight: 900;
        transition: transform 120ms ease, box-shadow 120ms ease, border-color 120ms ease;
      }
      .pill:hover { transform: translateY(-1px) scale(1.06); border-color: rgba(255, 128, 0, 0.38); box-shadow: 0 18px 54px rgba(255, 128, 0, 0.12); }
      .pillIcon {
        width: 28px; height: 28px;
        display: grid; place-items: center;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.22);
        border: 1px solid rgba(255, 255, 255, 0.12);
        font-weight: 950;
      }

      /* ── Footer ── */
      .footer {
        max-width: 1080px;
        margin: 0 auto;
        padding: 26px 18px 40px;
        color: rgba(238, 244, 255, 0.62);
        display: flex;
        justify-content: space-between;
        gap: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }
      .footerLink { color: rgba(238, 244, 255, 0.72); text-decoration: none; font-weight: 900; }
      .footerLink:hover { color: var(--papaya); }

      /* ── Responsive ── */
      @media (max-width: 860px) {
        .navLinks { gap: 10px; }
        .navLink  { display: none; }
        .projectsHeader { grid-template-columns: 1fr; }
        .projectsHeaderRight { text-align: left; }
        .projectsIcons { justify-content: flex-start; }
        .projGrid  { grid-template-columns: 1fr; }
        .aboutGrid { grid-template-columns: 1fr; }
        .vLine { left: 18px; }
        .vItem { padding-left: 48px; }
      }

      @media (prefers-reduced-motion: reduce) {
        .nameFrame::before { animation: none; }
        .hintArrow { animation: none; }
        .reveal { transition: opacity 200ms ease; }
      }
    </style>

  </body>
</html>
